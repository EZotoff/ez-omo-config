#!/usr/bin/env bash
set -euo pipefail

SELF="$(realpath "$0")"
SCRIPT_DIR="$(dirname "$SELF")"
SCHEMA="$SCRIPT_DIR/bench-campaign.schema.json"
DEFAULT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bench-campaign"
STATE_DIR="${BENCH_CAMPAIGN_STATE_DIR:-$DEFAULT_STATE_DIR}"

usage() {
  cat <<'EOF'
bench-campaign - manifest-driven benchmark campaign launcher

Usage:
  bench-campaign launch <manifest.json>
  bench-campaign status [run-id]
  bench-campaign --validate-manifest <manifest.json>
  bench-campaign --help

MVP contract:
  launch validates and copies the manifest, then starts the campaign as the
  transient user service bench-campaign-<run-id>.service. Each declared case
  gets complete stdout/stderr logs and an exit record. The final ledger is
  durable under ~/.local/state/bench-campaign/<run-id>/.

  Credential values are deny-by-default. A manifest may name only
  opencode-auth, repo-env-local, or repo-env-dev. Values are loaded inside the
  service process, never persisted in a resolved manifest or passed to systemd.
  Persisted environment is limited to LANG, LC_ALL, and TZ.

  BENCH_CAMPAIGN_STATE_DIR may override the state root for isolated tests.

Phase 2 (defined, disabled):
  A future runner may emit secret-free JSONL failure records with fields
  {schemaVersion,caseId,phase,kind,code,fingerprint,retryable}. Fingerprints
  must be stable and secret-free. Resume, quota orchestration, and automatic
  circuit breaking remain disabled until pilot evidence authorises them.
EOF
}

die() { printf 'bench-campaign: %s\n' "$*" >&2; exit 2; }

secure_dir() {
  mkdir -p "$1"
  chmod 700 "$1"
}

validate_manifest() {
  local manifest="$1"
  [[ -r "$manifest" ]] || die "manifest is not readable: $manifest"
  MANIFEST="$manifest" SCHEMA="$SCHEMA" python3 - <<'PY'
import json
import math
import os
import re
import sys

try:
    with open(os.environ["MANIFEST"], encoding="utf-8") as handle:
        manifest = json.load(handle)
    with open(os.environ["SCHEMA"], encoding="utf-8") as handle:
        schema = json.load(handle)
except (OSError, ValueError) as error:
    print(f"bench-campaign: invalid JSON: {error}", file=sys.stderr)
    raise SystemExit(2)

def check(value, rule, path="$"):
    errors = []
    expected = rule.get("type")
    matches = {
        "object": lambda item: isinstance(item, dict),
        "array": lambda item: isinstance(item, list),
        "string": lambda item: isinstance(item, str),
        "integer": lambda item: isinstance(item, int) and not isinstance(item, bool),
        "number": lambda item: isinstance(item, (int, float)) and not isinstance(item, bool),
    }
    if expected and not matches[expected](value):
        return [f"{path}: expected {expected}"]
    if "const" in rule and value != rule["const"]:
        errors.append(f"{path}: must equal {rule['const']!r}")
    if "enum" in rule and value not in rule["enum"]:
        errors.append(f"{path}: must be one of {rule['enum']!r}")
    if isinstance(value, str):
        if len(value) < rule.get("minLength", 0):
            errors.append(f"{path}: string is too short")
        if "pattern" in rule and not re.search(rule["pattern"], value):
            errors.append(f"{path}: does not match {rule['pattern']}")
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in rule and value < rule["minimum"]:
            errors.append(f"{path}: must be at least {rule['minimum']}")
        if "exclusiveMaximum" in rule and value >= rule["exclusiveMaximum"]:
            errors.append(f"{path}: must be below {rule['exclusiveMaximum']}")
    if isinstance(value, list):
        if len(value) < rule.get("minItems", 0):
            errors.append(f"{path}: requires at least {rule['minItems']} item(s)")
        if rule.get("uniqueItems"):
            encoded = [json.dumps(item, sort_keys=True) for item in value]
            if len(encoded) != len(set(encoded)):
                errors.append(f"{path}: items must be unique")
        item_rule = rule.get("items")
        if item_rule:
            for index, item in enumerate(value):
                errors.extend(check(item, item_rule, f"{path}.{index}"))
    if isinstance(value, dict):
        properties = rule.get("properties", {})
        for name in rule.get("required", []):
            if name not in value:
                errors.append(f"{path}: missing required property {name}")
        if rule.get("additionalProperties") is False:
            for name in value.keys() - properties.keys():
                errors.append(f"{path}.{name}: additional property is not allowed")
        for name, child in value.items():
            if name in properties:
                errors.extend(check(child, properties[name], f"{path}.{name}"))
    return errors

errors = check(manifest, schema)
if errors:
    for error in errors:
        print(f"bench-campaign: schema violation at {error}", file=sys.stderr)
    raise SystemExit(2)

arms = {arm["id"]: arm for arm in manifest["arms"]}
if len(arms) != len(manifest["arms"]):
    print("bench-campaign: schema violation: arm ids must be unique", file=sys.stderr)
    raise SystemExit(2)

phase_ids = set()
groups = {}
total_cases = 0
for phase in manifest["phases"]:
    if phase["id"] in phase_ids:
        print(f"bench-campaign: schema violation: duplicate phase id {phase['id']}", file=sys.stderr)
        raise SystemExit(2)
    phase_ids.add(phase["id"])
    unknown = sorted(set(phase["armIds"]) - set(arms))
    if unknown:
        print(f"bench-campaign: schema violation: phase {phase['id']} names unknown arms: {', '.join(unknown)}", file=sys.stderr)
        raise SystemExit(2)
    if phase["kind"] == "sut":
        mismatched = [arm_id for arm_id in phase["armIds"] if arms[arm_id]["sutModel"] != phase["model"]]
        if mismatched:
            print(f"bench-campaign: SUT substitution is invalid: phase {phase['id']} model {phase['model']} does not match arm(s) {', '.join(mismatched)}", file=sys.stderr)
            raise SystemExit(2)
    groups.setdefault(phase["processGroup"], []).append(phase)
    total_cases += len(phase["expectedCases"])

for group_name, phases in groups.items():
    families = {phase["endpointFamily"] for phase in phases}
    if len(families) > 1:
        details = ", ".join(f"{phase['model']} ({phase['endpointFamily']})" for phase in phases)
        print(
            f"bench-campaign: process group {group_name} mixes endpoint families: {details}; "
            "SUT and judge using different endpoint families require two endpoint-isolated phases/process groups",
            file=sys.stderr,
        )
        raise SystemExit(2)

quota = manifest["quota"]
admitted = math.floor(quota["budgetCases"] * (100 - quota["headroomPercent"]) / 100)
if total_cases > admitted:
    print(
        f"bench-campaign: quota violation: {total_cases} expected cases exceed {admitted} admitted "
        f"from budget {quota['budgetCases']} with {quota['headroomPercent']}% headroom",
        file=sys.stderr,
    )
    raise SystemExit(2)

print(f"valid manifest: {manifest['runId']} ({total_cases} cases)")
PY
}

manifest_value() {
  local manifest="$1" expression="$2"
  MANIFEST="$manifest" EXPR="$expression" python3 - <<'PY'
import json, os
with open(os.environ["MANIFEST"], encoding="utf-8") as handle:
    value = json.load(handle)
for part in os.environ["EXPR"].split("."):
    value = value[part]
print(value)
PY
}

write_resolved_manifest() {
  local source="$1" destination="$2"
  SOURCE="$source" DESTINATION="$destination" python3 - <<'PY'
import json, os
with open(os.environ["SOURCE"], encoding="utf-8") as handle:
    manifest = json.load(handle)
allowed = {}
for name in manifest["persistEnvironment"]:
    if name in os.environ:
        allowed[name] = os.environ[name]
resolved = {
    "schemaVersion": manifest["schemaVersion"],
    "runId": manifest["runId"],
    "repositoryRoot": manifest["repositoryRoot"],
    "outputDirectory": manifest["outputDirectory"],
    "monitoringOwner": manifest["monitoringOwner"],
    "quota": manifest["quota"],
    "diskThresholdGb": manifest["diskThresholdGb"],
    "persistedEnvironment": allowed,
    "arms": manifest["arms"],
    "phases": manifest["phases"],
}
with open(os.environ["DESTINATION"], "x", encoding="utf-8") as handle:
    json.dump(resolved, handle, indent=2)
    handle.write("\n")
PY
  chmod 600 "$destination"
}

launch() {
  local manifest run_id run_dir unit
  manifest="$(realpath "$1")"
  validate_manifest "$manifest" >/dev/null
  run_id="$(manifest_value "$manifest" runId)"
  run_dir="$STATE_DIR/$run_id"
  unit="bench-campaign-$run_id.service"

  secure_dir "$STATE_DIR"
  if ! mkdir "$run_dir" 2>/dev/null; then
    die "run already exists: $run_id"
  fi
  chmod 700 "$run_dir"
  exec 9>"$run_dir/launch.lock"
  flock -n 9 || die "run is locked: $run_id"
  install -m 600 "$manifest" "$run_dir/manifest.json"
  write_resolved_manifest "$manifest" "$run_dir/resolved-manifest.json"

  /usr/bin/systemd-run --user --unit="$unit" --collect \
    --property=Type=exec --property=UMask=0077 \
    --property=StandardOutput=journal --property=StandardError=journal \
    --description="Benchmark campaign $run_id" \
    /usr/bin/env -i "HOME=$HOME" "PATH=/usr/local/bin:/usr/bin:/bin" \
    "$SELF" __run "$run_id" "$STATE_DIR" >/dev/null
  printf '%s\n' "$run_id"
}

load_credentials() {
  local manifest="$1" repository_root source env_file
  repository_root="$(manifest_value "$manifest" repositoryRoot)"
  while IFS= read -r source; do
    case "$source" in
      opencode-auth)
        env_file="$HOME/.local/share/opencode/auth.json"
        [[ -r "$env_file" ]] || die "credential source unavailable: opencode-auth"
        BENCH_CREDENTIAL_OPENCODE_AUTH_JSON="$(<"$env_file")"
        export BENCH_CREDENTIAL_OPENCODE_AUTH_JSON
        ;;
      repo-env-local|repo-env-dev)
        if [[ "$source" == repo-env-local ]]; then
          env_file="$repository_root/apps/web/.env.local"
        else
          env_file="$repository_root/apps/web/.env.dev"
        fi
        [[ -r "$env_file" ]] || die "credential source unavailable: $source"
        set -a
        # Named repo env files are trusted credential stores chosen by the manifest.
        # shellcheck disable=SC1090
        . "$env_file"
        set +a
        ;;
      *) die "unsupported credential source: $source" ;;
    esac
  done < <(MANIFEST="$manifest" python3 - <<'PY'
import json, os
with open(os.environ["MANIFEST"], encoding="utf-8") as handle:
    manifest = json.load(handle)
print("\n".join(dict.fromkeys(source for phase in manifest["phases"] for source in phase["credentialSources"])))
PY
)
}

write_ledger() {
  local manifest="$1" ledger="$2" status="$3" exit_code="$4" results_file="$5"
  MANIFEST="$manifest" LEDGER="$ledger" STATUS="$status" EXIT_CODE="$exit_code" RESULTS="$results_file" python3 - <<'PY'
import json, os, time
with open(os.environ["MANIFEST"], encoding="utf-8") as handle:
    manifest = json.load(handle)
results = []
if os.path.exists(os.environ["RESULTS"]):
    with open(os.environ["RESULTS"], encoding="utf-8") as handle:
        results = [json.loads(line) for line in handle if line.strip()]
expected = sum(len(phase["expectedCases"]) for phase in manifest["phases"])
payload = {
    "schemaVersion": 1,
    "runId": manifest["runId"],
    "unit": f"bench-campaign-{manifest['runId']}.service",
    "monitoringOwner": manifest["monitoringOwner"],
    "status": os.environ["STATUS"],
    "completedCases": len(results),
    "expectedCases": expected,
    "exitCode": int(os.environ["EXIT_CODE"]),
    "results": results,
    "updatedAtEpoch": int(time.time()),
    "phase2": {
        "enabled": False,
        "failureRecordFields": ["schemaVersion", "caseId", "phase", "kind", "code", "fingerprint", "retryable"],
        "fingerprintContract": "stable and secret-free",
        "gatedOn": "pilot evidence"
    }
}
temporary = os.environ["LEDGER"] + ".tmp"
with open(temporary, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, indent=2)
    handle.write("\n")
os.chmod(temporary, 0o600)
os.replace(temporary, os.environ["LEDGER"])
PY
}

run_campaign() {
  local run_id="$1" state_dir="$2" run_dir manifest output_dir threshold ledger results
  local overall_exit=0 completed=0 phase_count phase_index case_count case_index
  run_dir="$state_dir/$run_id"
  manifest="$run_dir/manifest.json"
  ledger="$run_dir/ledger.json"
  results="$run_dir/case-results.jsonl"
  [[ -r "$manifest" ]] || die "owned manifest missing for run: $run_id"
  exec 8>"$run_dir/run.lock"
  flock -n 8 || die "run is already active: $run_id"

  output_dir="$(manifest_value "$manifest" outputDirectory)"
  threshold="$(manifest_value "$manifest" diskThresholdGb)"
  secure_dir "$output_dir"
  secure_dir "$output_dir/cases"
  : >"$results"
  chmod 600 "$results"
  write_ledger "$manifest" "$ledger" running 0 "$results"
  load_credentials "$manifest"

  phase_count="$(MANIFEST="$manifest" python3 -c 'import json,os; print(len(json.load(open(os.environ["MANIFEST"]))["phases"]))')"
  for ((phase_index=0; phase_index<phase_count; phase_index++)); do
    local phase_id
    phase_id="$(MANIFEST="$manifest" INDEX="$phase_index" python3 -c 'import json,os; print(json.load(open(os.environ["MANIFEST"]))["phases"][int(os.environ["INDEX"])]["id"])')"
    case_count="$(MANIFEST="$manifest" INDEX="$phase_index" python3 -c 'import json,os; print(len(json.load(open(os.environ["MANIFEST"]))["phases"][int(os.environ["INDEX"])]["expectedCases"]))')"
    for ((case_index=0; case_index<case_count; case_index++)); do
      local case_id stem stdout_log stderr_log free_kb threshold_kb exit_code
      case_id="$(MANIFEST="$manifest" PI="$phase_index" CI="$case_index" python3 -c 'import json,os; print(json.load(open(os.environ["MANIFEST"]))["phases"][int(os.environ["PI"])]["expectedCases"][int(os.environ["CI"])])')"
      stem="$(printf '%03d-%s-%s' "$((completed + 1))" "$phase_id" "$case_id" | tr -c 'A-Za-z0-9._-' '_')"
      stdout_log="$output_dir/cases/$stem.stdout.log"
      stderr_log="$output_dir/cases/$stem.stderr.log"
      free_kb="$(df -Pk "$output_dir" | python3 -c 'import sys; print(sys.stdin.read().splitlines()[-1].split()[3])')"
      threshold_kb="$(THRESHOLD="$threshold" python3 -c 'import os; print(int(float(os.environ["THRESHOLD"])*1024*1024))')"
      if (( free_kb < threshold_kb )); then
        overall_exit=75
        printf 'disk threshold reached: free_kb=%s threshold_gb=%s; evidence retained; use /cleanup-discipline\n' "$free_kb" "$threshold" >"$stderr_log"
        : >"$stdout_log"
        chmod 600 "$stdout_log" "$stderr_log"
        exit_code=75
      else
        export BENCH_CAMPAIGN_RUN_ID="$run_id" BENCH_CAMPAIGN_PHASE="$phase_id" BENCH_CASE_ID="$case_id" BENCH_CAMPAIGN_OUTPUT_DIR="$output_dir"
        set +e
        MANIFEST="$manifest" INDEX="$phase_index" python3 - <<'PY' >"$run_dir/command.nul"
import json, os, sys
with open(os.environ["MANIFEST"], encoding="utf-8") as handle:
    command = json.load(handle)["phases"][int(os.environ["INDEX"])]["runnerCommand"]
sys.stdout.buffer.write(b"\0".join(part.encode() for part in command) + b"\0")
PY
        mapfile -d '' -t command <"$run_dir/command.nul"
        rm -f "$run_dir/command.nul"
        "${command[@]}" >"$stdout_log" 2>"$stderr_log"
        exit_code=$?
        set -e
        chmod 600 "$stdout_log" "$stderr_log"
        (( exit_code == 0 )) || overall_exit=1
      fi
      RESULT_PHASE="$phase_id" RESULT_CASE="$case_id" RESULT_EXIT="$exit_code" python3 - <<'PY' >>"$results"
import json, os
print(json.dumps({"phase": os.environ["RESULT_PHASE"], "caseId": os.environ["RESULT_CASE"], "exitCode": int(os.environ["RESULT_EXIT"])}))
PY
      completed=$((completed + 1))
      write_ledger "$manifest" "$ledger" running "$overall_exit" "$results"
      (( exit_code != 0 )) && break 2
    done
  done
  if (( completed == $(MANIFEST="$manifest" python3 -c 'import json,os; print(sum(len(p["expectedCases"]) for p in json.load(open(os.environ["MANIFEST"]))["phases"]))') )); then
    write_ledger "$manifest" "$ledger" completed "$overall_exit" "$results"
  else
    write_ledger "$manifest" "$ledger" stopped "$overall_exit" "$results"
  fi
  exit "$overall_exit"
}

status() {
  local requested="${1:-}" run_dir run_id unit active ledger_status completed expected exit_code
  secure_dir "$STATE_DIR"
  if [[ -n "$requested" ]]; then
    [[ "$requested" =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || die "invalid run id"
    [[ -d "$STATE_DIR/$requested" ]] || die "unknown run id: $requested"
    run_dirs=("$STATE_DIR/$requested")
  else
    shopt -s nullglob
    run_dirs=("$STATE_DIR"/*)
  fi
  printf 'RUN_ID\tSERVICE\tSTATUS\tCASES\tEXIT\n'
  for run_dir in "${run_dirs[@]:-}"; do
    [[ -d "$run_dir" ]] || continue
    run_id="$(basename "$run_dir")"
    unit="bench-campaign-$run_id.service"
    active="$(systemctl --user is-active "$unit" 2>/dev/null || true)"
    if [[ -r "$run_dir/ledger.json" ]]; then
      read -r ledger_status completed expected exit_code < <(LEDGER="$run_dir/ledger.json" python3 -c 'import json,os; d=json.load(open(os.environ["LEDGER"])); print(d["status"],d["completedCases"],d["expectedCases"],d["exitCode"])')
      [[ "$active" == active || "$active" == activating ]] && ledger_status="$active"
      printf '%s\t%s\t%s\t%s/%s\t%s\n' "$run_id" "$unit" "$ledger_status" "$completed" "$expected" "$exit_code"
    else
      printf '%s\t%s\t%s\t0/?\t?\n' "$run_id" "$unit" "${active:-launching}"
    fi
  done
}

case "${1:-}" in
  --help|-h) usage ;;
  --validate-manifest) [[ $# -eq 2 ]] || die "--validate-manifest needs one path"; validate_manifest "$2" ;;
  launch) [[ $# -eq 2 ]] || die "launch needs one manifest path"; launch "$2" ;;
  status) [[ $# -le 2 ]] || die "status accepts at most one run id"; status "${2:-}" ;;
  __run) [[ $# -eq 3 ]] || die "internal invocation is invalid"; run_campaign "$2" "$3" ;;
  *) usage >&2; exit 2 ;;
esac
