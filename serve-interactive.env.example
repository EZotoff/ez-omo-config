# OpenCode interactive daemon basic auth (opencode-interactive.service on 127.0.0.1:3030).
# Copy to ~/.config/opencode/serve-interactive.env, chmod 600, and set a strong password.
# This file is the desktop `oa()` wrapper's credential source and the daemon's auth gate
# in front of the OC Beacon Android client (exposed tailnet-only via `tailscale serve` TLS).
# NEVER commit the filled-in copy.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
