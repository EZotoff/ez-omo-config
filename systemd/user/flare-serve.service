[Unit]
Description=FLARE-4B local SGLang server (self-spec AR-Trust) — small_model / title generation for OpenCode
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/src/flare/eval
Environment=HYBRID_DIFFUSION_CACHE_ROOT=%h/flare-cache
Environment=EVAL_VENV=%h/src/flare/cache/venvs/hybrid-diffusion-eval
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=HOST=127.0.0.1
Environment=PORT=18200
Environment=MEM_FRACTION_STATIC=0.84
Environment=MAX_RUNNING_REQUESTS=4
Environment="CUDA_GRAPH_BS=1 2 4"
ExecStart=%h/src/flare/eval/scripts/serve.sh self-spec yzhu738/FLARE-4B -- --served-model-name flare-4b --chat-template %h/flare-cache/chat-template-nothink.jinja
Restart=on-failure
RestartSec=10
# First launch JIT-compiles Triton/FlashInfer kernels and can take several minutes
# chat-template-nothink.jinja: derived from the FLARE-4B tokenizer_config.json
# chat_template by scripts/derive-flare-chat-template.py — forces the no-think
# branch AND merges consecutive leading system messages (OpenCode always sends
# [system, system, user, ...]; the stock template 400s on the 2nd system msg).
# Regenerate via that script if the model is upgraded.
TimeoutStartSec=900

[Install]
WantedBy=default.target
