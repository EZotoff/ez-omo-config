[Unit]
Description=OpenCode Daemon Keeper — auto-recover opencode-interactive.service (:3030) and opencode-bench.service
# Recovers the daemons after agent-run update procedures stop them and die
# before the restart step (2026-09-13/14, 2026-09-21 incidents). systemd
# Restart= never fires on explicit stops, so a probe timer is the only
# coverage for this failure class.
After=opencode-interactive.service

[Service]
Type=oneshot
ExecStart=%h/ez-omo-config/scripts/opencode-daemon-keeper.sh
