[Unit]
Description=OpenCode Patch Integrity Check — periodic verify-live-patches run + live-config drift check
OnFailure=opencode-integrity-triage.service
After=default.target

[Service]
Type=oneshot
ExecStart=%h/ez-omo-config/scripts/verify-live-patches.sh
ExecStart=%h/ez-omo-config/scripts/check-live-config-drift.sh
ExecStart=%h/ez-omo-config/scripts/check-remote-presence.sh
ExecStart=%h/ez-omo-config/scripts/check-provenance.sh
Environment=EZ_OMO_CONFIG_REPO=%h/ez-omo-config
