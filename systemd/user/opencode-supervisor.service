# Requires the repository checked out at ~/ez-omo-config.
[Unit]
Description=OpenCode Project Supervisor (P0 shadow mode)
After=opencode.service
Wants=opencode.service

[Service]
Type=simple
TimeoutStopSec=300
EnvironmentFile=%h/.config/opencode/serve.env
ExecStart=%h/.bun/bin/bun run %h/ez-omo-config/supervisor/src/main.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
